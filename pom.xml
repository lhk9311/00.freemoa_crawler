<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 부모 POM: 스프링 부트가 라이브러리 버전 조합을 관리해준다 (ojdbc11 버전도 여기서 결정됨) -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>com.lhk</groupId>
    <artifactId>freemoa-crawler</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>freemoa-crawler</name>
    <description>프리모아 프로젝트 공고 수집 + Oracle/SQL 연습</description>

    <properties>
        <java.version>17</java.version>
        <mybatis-starter.version>3.0.4</mybatis-starter.version>
        <!-- main 메서드가 2개(Spring용, 순수 Java용)라서 실행 jar의 진입점을 명시 -->
        <start-class>com.lhk.freemoa.FreemoaCrawlerApplication</start-class>
    </properties>

    <dependencies>
        <!-- REST API (내장 톰캣 포함) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- MyBatis: SQL을 XML에 직접 작성 (SI 표준) -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>${mybatis-starter.version}</version>
        </dependency>

        <!--
          JPA (Hibernate): 일부 조회 기능을 JPA로 구현해서 MyBatis와 비교하기 위함.
          저장(쓰기)은 계속 MyBatis가 담당한다. 둘은 같은 DataSource와 트랜잭션 매니저를 공유한다.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Oracle JDBC 드라이버 (버전은 부모 POM이 관리) -->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 테스트 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- API 문서: 테스트(MockMvc)가 통과해야 문서 조각(snippet)이 만들어진다 (버전은 부모 POM이 관리) -->
        <dependency>
            <groupId>org.springframework.restdocs</groupId>
            <artifactId>spring-restdocs-mockmvc</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
              API 문서 생성 (Spring REST Docs)
              1) mvn test        : *DocsTest가 target/generated-snippets/ 에 요청/응답 조각(.adoc)을 만든다
              2) mvn package     : src/docs/asciidoc/api.adoc 이 조각들을 include 해서 target/generated-docs/api.html 생성
              3) 같은 단계에서 api.html 을 static/docs 로 복사 -> 서버 실행 후 http://localhost:8080/docs/api.html
            -->
            <plugin>
                <groupId>org.asciidoctor</groupId>
                <artifactId>asciidoctor-maven-plugin</artifactId>
                <version>2.2.1</version>
                <executions>
                    <execution>
                        <id>generate-docs</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>process-asciidoc</goal>
                        </goals>
                        <configuration>
                            <backend>html</backend>
                            <doctype>book</doctype>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <!-- 플러그인 의존성은 BOM 버전 관리가 안 돼서 부모 POM의 속성으로 버전을 맞춘다 -->
                    <dependency>
                        <groupId>org.springframework.restdocs</groupId>
                        <artifactId>spring-restdocs-asciidoctor</artifactId>
                        <version>${spring-restdocs.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-api-docs</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/static/docs</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.build.directory}/generated-docs</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
