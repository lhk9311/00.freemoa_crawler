<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lhk.freemoa.project.query.ProjectQueryMapper">

    <!--
        목록 조회와 건수 조회가 "같은 조건"을 쓰도록 WHERE 절을 한 곳에 정의하고 <include>로 재사용한다.
        조건이 따로 놀면 "목록은 10건인데 총 건수는 50건" 같은 버그가 생긴다.

        <where>: 안쪽 조건이 하나도 없으면 WHERE를 아예 안 붙이고,
                 첫 조건의 AND를 자동으로 떼어준다.
    -->
    <sql id="searchCondition">
        <where>
            <if test="keyword != null and keyword != ''">
                AND UPPER(P.TITLE) LIKE '%' || UPPER(#{keyword}) || '%'
            </if>
            <if test="region != null and region != ''">
                AND P.REGION = #{region}
            </if>
            <if test="minCost != null">
                AND P.COST_MAX &gt;= #{minCost}
            </if>
            <if test="openOnly">
                AND P.DEADLINE &gt;= TRUNC(SYSDATE)
            </if>
            <if test="skillKey != null and skillKey != ''">
                <!--
                    상관 서브쿼리 + EXISTS
                    바깥 행(P)마다 "이 공고에 해당 기술이 있는가?"를 확인한다.
                    JOIN으로 풀면 기술이 여러 개 매칭될 때 공고가 중복으로 나올 수 있지만,
                    EXISTS는 하나라도 찾으면 바로 멈추고 true라서 중복이 생기지 않는다.
                -->
                AND EXISTS (
                    SELECT 1
                      FROM TB_PROJECT_SKILL PS
                      JOIN TB_SKILL S ON S.SKILL_ID = PS.SKILL_ID
                     WHERE PS.PROJ_IDX = P.PROJ_IDX
                       AND S.SKILL_KEY = #{skillKey}
                )
            </if>
        </where>
    </sql>

    <select id="selectProjects" resultType="com.lhk.freemoa.project.query.ProjectRow">
        SELECT P.PROJ_IDX
             , P.TITLE
             , P.REGION
             , P.COST_MIN
             , P.COST_MAX
             , P.APPLY_COUNT
             , P.DEADLINE
               <!--
                   스칼라 서브쿼리: SELECT 절 안에서 "값 1개"를 돌려주는 서브쿼리.
                   LISTAGG: 여러 행을 하나의 문자열로 합친다 ("Java, Oracle, Spring")
               -->
             , (SELECT LISTAGG(S.SKILL_NAME, ', ') WITHIN GROUP (ORDER BY S.SKILL_NAME)
                  FROM TB_PROJECT_SKILL PS
                  JOIN TB_SKILL S ON S.SKILL_ID = PS.SKILL_ID
                 WHERE PS.PROJ_IDX = P.PROJ_IDX) AS SKILLS
          FROM TB_PROJECT P
        <include refid="searchCondition"/>
         ORDER BY P.POSTED_AT DESC NULLS LAST, P.PROJ_IDX DESC
        <!-- Oracle 12c부터 지원하는 표준 페이징 문법. 예전 방식은 ROWNUM을 2중 인라인 뷰로 감쌌다 -->
        OFFSET #{offset} ROWS FETCH NEXT #{limit} ROWS ONLY
    </select>

    <select id="countProjects" resultType="int">
        SELECT COUNT(*)
          FROM TB_PROJECT P
        <include refid="searchCondition"/>
    </select>

    <select id="selectTopSkills" resultType="com.lhk.freemoa.project.query.SkillCount">
        SELECT S.SKILL_KEY
             , S.SKILL_NAME
             , COUNT(*) AS CNT
          FROM TB_PROJECT_SKILL PS
          JOIN TB_SKILL S ON S.SKILL_ID = PS.SKILL_ID
         GROUP BY S.SKILL_KEY, S.SKILL_NAME
         ORDER BY CNT DESC, S.SKILL_NAME
         FETCH FIRST #{limit} ROWS ONLY
    </select>

</mapper>
