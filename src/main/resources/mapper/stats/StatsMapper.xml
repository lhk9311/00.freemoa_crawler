<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lhk.freemoa.stats.StatsMapper">

    <!--
      통계 SQL 모음.
       - 기술 통계: 공고 x 태그 원본만 가져오고 묶기는 자바에서 (selectProjectSkills)
       - 지역 통계: 결과 컬럼을 LABEL, CNT, PCT 로 맞춰서 StatRow로 받는다

      윈도우 함수 (분석 함수) 정리
        일반 집계(COUNT, SUM)는 GROUP BY로 행을 "줄인다".
        윈도우 함수는 행을 줄이지 않고, 각 행 옆에 "전체(또는 구간) 기준 값"을 붙인다.
          RATIO_TO_REPORT(x) OVER ()        : 전체 합계 대비 이 행의 비율 (0~1)
          SUM(x) OVER (ORDER BY 월)         : 처음부터 이 행까지의 누적 합계
          RANK() OVER (ORDER BY x DESC)     : 순위 (동점이면 같은 순위, 다음 순위는 건너뜀)
        OVER () 안이 비어 있으면 "결과 전체"가 기준이다.
    -->

    <select id="countProjects" resultType="int">
        SELECT COUNT(*) FROM TB_PROJECT
    </select>

    <!--
      공고 x 기술 태그 원본
       공고 1건에 태그가 4개면 같은 PROJ_IDX로 4줄이 나온다.
       여기서 GROUP BY 하지 않는 이유: "php 8.5"와 "PHP"를 같은 기술로 합치는 규칙이 자바(BackendTechCatalog)에 있어서,
       SQL에서 SKILL_KEY별로 세면 같은 공고의 PHP가 두 번 세어진다. 묶기는 TechStatsCalculator가 한다.
       공고 수천 건 x 태그 몇 개라 수만 줄 정도. 통계 화면을 열 때 한 번 읽는 양으로는 충분히 가볍다.
    -->
    <select id="selectProjectSkills" resultType="com.lhk.freemoa.stats.ProjectSkillRow">
        SELECT P.PROJ_IDX
             , S.SKILL_KEY
             , S.SKILL_NAME
             , P.APPLY_COUNT
             , P.COST_MAX
          FROM TB_PROJECT_SKILL PS
          JOIN TB_SKILL   S ON S.SKILL_ID = PS.SKILL_ID
          JOIN TB_PROJECT P ON P.PROJ_IDX = PS.PROJ_IDX
    </select>

    <!--
      지역별 통계
       - PCT: RATIO_TO_REPORT로 전체 공고 대비 비율. 지역은 공고당 하나라 합이 100%다.
       GROUP BY 결과(지역별 COUNT)에 다시 윈도우 함수를 씌운다: COUNT(*)가 먼저 계산되고, 그 결과 행들 전체가 OVER ()의 기준이 된다.
    -->
    <select id="selectRegionStats" resultType="com.lhk.freemoa.stats.StatRow">
        SELECT NVL(REGION, '미지정')                             AS LABEL
             , COUNT(*)                                          AS CNT
             , ROUND(RATIO_TO_REPORT(COUNT(*)) OVER () * 100, 1) AS PCT
          FROM TB_PROJECT
         GROUP BY NVL(REGION, '미지정')
         ORDER BY CNT DESC
    </select>

</mapper>
