<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="frmProjectList" width="1280" height="720" titletext="프리모아 공고 조회" onload="Form_onload">
    <Layouts>
      <Layout height="720" width="1280">
        <!-- ===== 조회 조건 ===== -->
        <Static id="sta_keyword" taborder="0" text="검색어" left="20" top="20" width="50" height="28"/>
        <Edit id="edt_keyword" taborder="1" left="70" top="20" width="180" height="28"/>
        <Static id="sta_skill" taborder="2" text="기술" left="270" top="20" width="40" height="28"/>
        <Combo id="cbo_skill" taborder="3" left="310" top="20" width="180" height="28" innerdataset="ds_skill" codecolumn="skillKey" datacolumn="label"/>
        <Static id="sta_region" taborder="4" text="지역" left="510" top="20" width="40" height="28"/>
        <Edit id="edt_region" taborder="5" left="550" top="20" width="90" height="28"/>
        <Static id="sta_minCost" taborder="6" text="최소예산(만원)" left="660" top="20" width="100" height="28"/>
        <Edit id="edt_minCost" taborder="7" left="760" top="20" width="90" height="28"/>
        <CheckBox id="chk_openOnly" taborder="8" text="모집중만" left="870" top="20" width="90" height="28"/>
        <Button id="btn_search" taborder="9" text="조회" left="1170" top="20" width="90" height="28" onclick="btn_search_onclick"/>

        <!-- ===== 건수 / 페이징 ===== -->
        <Static id="sta_total" taborder="10" text="총 0건" left="20" top="60" width="200" height="24"/>
        <Button id="btn_prev" taborder="11" text="이전" left="1060" top="58" width="60" height="26" onclick="btn_prev_onclick"/>
        <Static id="sta_page" taborder="12" text="1 / 1" left="1125" top="60" width="70" height="24"/>
        <Button id="btn_next" taborder="13" text="다음" left="1200" top="58" width="60" height="26" onclick="btn_next_onclick"/>

        <!-- ===== 목록 ===== -->
        <Grid id="grd_list" taborder="14" left="20" top="92" right="20" bottom="64" binddataset="ds_list" autofittype="col">
          <Formats>
            <Format id="default">
              <Columns>
                <Column size="70"/>
                <Column size="420"/>
                <Column size="70"/>
                <Column size="90"/>
                <Column size="90"/>
                <Column size="60"/>
                <Column size="100"/>
                <Column size="340"/>
              </Columns>
              <Rows>
                <Row size="28" band="head"/>
                <Row size="26"/>
              </Rows>
              <Band id="head">
                <Cell text="번호"/>
                <Cell col="1" text="제목"/>
                <Cell col="2" text="지역"/>
                <Cell col="3" text="최소예산"/>
                <Cell col="4" text="최대예산"/>
                <Cell col="5" text="지원자"/>
                <Cell col="6" text="마감일"/>
                <Cell col="7" text="기술스택"/>
              </Band>
              <Band id="body">
                <Cell text="bind:projIdx"/>
                <Cell col="1" text="bind:title" textAlign="left"/>
                <Cell col="2" text="bind:region"/>
                <Cell col="3" text="bind:costMin" displaytype="number" textAlign="right"/>
                <Cell col="4" text="bind:costMax" displaytype="number" textAlign="right"/>
                <Cell col="5" text="bind:applyCount" textAlign="right"/>
                <Cell col="6" text="bind:deadline" displaytype="date"/>
                <Cell col="7" text="bind:skills" textAlign="left"/>
              </Band>
            </Format>
          </Formats>
        </Grid>

        <!-- ===== 수집 실행 ===== -->
        <Static id="sta_crawl" taborder="15" text="수집 검색어" left="20" top="676" width="80" height="28"/>
        <Edit id="edt_crawlKeyword" taborder="16" left="100" top="676" width="160" height="28"/>
        <Static id="sta_crawlPages" taborder="17" text="페이지 수" left="280" top="676" width="70" height="28"/>
        <Edit id="edt_crawlPages" taborder="18" value="1" left="350" top="676" width="60" height="28"/>
        <Button id="btn_crawl" taborder="19" text="수집 실행" left="430" top="676" width="100" height="28" onclick="btn_crawl_onclick"/>
      </Layout>
    </Layouts>

    <Objects>
      <Dataset id="ds_list">
        <ColumnInfo>
          <Column id="projIdx" type="INT" size="10"/>
          <Column id="title" type="STRING" size="500"/>
          <Column id="region" type="STRING" size="50"/>
          <Column id="costMin" type="INT" size="10"/>
          <Column id="costMax" type="INT" size="10"/>
          <Column id="applyCount" type="INT" size="6"/>
          <Column id="deadline" type="DATE" size="8"/>
          <Column id="skills" type="STRING" size="1000"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_page">
        <ColumnInfo>
          <Column id="totalCount" type="INT" size="10"/>
          <Column id="page" type="INT" size="10"/>
          <Column id="pageSize" type="INT" size="10"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_skill">
        <ColumnInfo>
          <Column id="skillKey" type="STRING" size="100"/>
          <Column id="skillName" type="STRING" size="100"/>
          <Column id="label" type="STRING" size="120"/>
          <Column id="cnt" type="INT" size="10"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_result">
        <ColumnInfo>
          <Column id="runId" type="INT" size="10"/>
          <Column id="status" type="STRING" size="10"/>
          <Column id="fetched" type="INT" size="7"/>
          <Column id="inserted" type="INT" size="7"/>
          <Column id="updated" type="INT" size="7"/>
          <Column id="failed" type="INT" size="7"/>
          <Column id="elapsedMs" type="INT" size="10"/>
        </ColumnInfo>
      </Dataset>
    </Objects>

    <Script type="xscript5.1"><![CDATA[
/**
 * 프리모아 공고 조회 화면
 *  - 서버 주소: TypeDefinition > Services 의 svc (http://localhost:8080/)
 *  - 서버 API : /nx/skills, /nx/projects/search, /nx/crawl
 */

this.page = 1;
this.pageSize = 50;

/* 화면 로드: 기술스택 콤보 목록 받기 */
this.Form_onload = function(obj, e)
{
    this.fnLoadSkills();
};

this.fnLoadSkills = function()
{
    // transaction(서비스ID, URL, 보낼Dataset, 받을Dataset(화면=서버), 인자, 콜백)
    this.transaction("skills", "svc::nx/skills", "", "ds_skill=ds_skill", "", "fnCallback");
};

/* 조회 */
this.btn_search_onclick = function(obj, e)
{
    this.page = 1;
    this.fnSearch();
};

this.btn_prev_onclick = function(obj, e)
{
    if (this.page <= 1) return;
    this.page--;
    this.fnSearch();
};

this.btn_next_onclick = function(obj, e)
{
    var total = this.ds_page.getColumn(0, "totalCount") || 0;
    if (this.page * this.pageSize >= total) return;
    this.page++;
    this.fnSearch();
};

this.fnSearch = function()
{
    var args = "";
    args += this.fnArg("keyword",  this.edt_keyword.value);
    args += this.fnArg("skillKey", this.cbo_skill.value);
    args += this.fnArg("region",   this.edt_region.value);
    args += this.fnArg("minCost",  this.edt_minCost.value);
    args += this.fnArg("openOnly", this.chk_openOnly.value);
    args += this.fnArg("page",     this.page);
    args += this.fnArg("pageSize", this.pageSize);

    this.transaction("search", "svc::nx/projects/search", "", "ds_list=ds_list ds_page=ds_page", args, "fnCallback");
};

/* 인자 문자열: "keyword='java spring' page=1 " (값이 비면 보내지 않음 -> 서버에서 조건 없음) */
this.fnArg = function(name, value)
{
    if (value == null || value === "") return "";
    return name + "=" + nexacro.wrapQuote(String(value)) + " ";
};

/* 수집 실행 */
this.btn_crawl_onclick = function(obj, e)
{
    var pages = this.edt_crawlPages.value || 1;
    if (!this.confirm(pages + "페이지(약 " + (pages * 10) + "건)를 수집합니다. 진행할까요?")) return;

    var args = "";
    args += this.fnArg("keyword",  this.edt_crawlKeyword.value);
    args += this.fnArg("maxPages", pages);

    this.btn_crawl.set_enable(false); // 수집 중 중복 클릭 방지 (서버도 409로 막음)
    this.transaction("crawl", "svc::nx/crawl", "", "ds_result=ds_result", args, "fnCallback");
};

/* 공통 콜백: errorCode < 0 이면 서버 에러(ErrorCode=-1) 또는 통신 실패 */
this.fnCallback = function(svcId, errorCode, errorMsg)
{
    if (svcId == "crawl") {
        this.btn_crawl.set_enable(true);
    }

    if (errorCode < 0) {
        this.alert("[" + svcId + "] " + errorMsg);
        return;
    }

    switch (svcId) {
        case "skills":
            this.cbo_skill.set_index(0); // "전체"
            break;

        case "search":
            var total = this.ds_page.getColumn(0, "totalCount") || 0;
            var lastPage = Math.max(1, Math.ceil(total / this.pageSize));
            this.sta_total.set_text("총 " + total + "건");
            this.sta_page.set_text(this.page + " / " + lastPage);
            break;

        case "crawl":
            var r = this.ds_result;
            this.alert("수집 " + r.getColumn(0, "status")
                + "\n가져온 공고 " + r.getColumn(0, "fetched") + "건"
                + "\n신규 " + r.getColumn(0, "inserted") + " / 갱신 " + r.getColumn(0, "updated")
                + " / 실패 " + r.getColumn(0, "failed"));
            this.fnLoadSkills();
            this.page = 1;
            this.fnSearch();
            break;
    }
};
]]></Script>
  </Form>
</FDL>
